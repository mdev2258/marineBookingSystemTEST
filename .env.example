# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every var below is explained in the README.
# ---------------------------------------------------------------------------

# Database. Postgres everywhere -- there is no SQLite mode.
# Neon/Supabase give you TWO connection strings and you need both:
#   DATABASE_URL = the POOLED one, used by the running app.
#                  Append ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = the DIRECT one, used by `prisma db push` and the seed.
# Use separate branches/databases for local dev and the demo.
DATABASE_URL="postgresql://USER:PASS@HOST-pooler/DB?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASS@HOST/DB?sslmode=require"

# Admin login. There is no user table -- these two values ARE the admin account.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
# HS256 signing key for the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Email (Resend). Leave RESEND_API_KEY blank to run in local log-only mode:
# emails are printed to the server console and still recorded in EmailLog.
RESEND_API_KEY=""
EMAIL_FROM="Harbourside Sailing <bookings@yourdomain.com>"
# Safety net for demos: every outbound email is redirected to this address
# regardless of the customer's real address. Leave blank to send for real.
DEMO_EMAIL_REDIRECT=""
# Where the marketing-page contact form is delivered.
CONTACT_RECIPIENT_EMAIL="you@yourdomain.com"

# Stripe. Not required to run the app -- src/lib/payments.ts ships stubbed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Absolute origin, used to build links inside emails.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Shared secret for GET /api/cron/reminders (Authorization: Bearer $CRON_SECRET).
CRON_SECRET=""

# The boatyard diary this app used to be, parked rather than deleted.
# "true" un-parks /admin/day, /admin/sessions/*, /book/* and /rebook/*.
# Read at module scope, so a deployment needs a redeploy, not just a change here.
FEATURE_YARD=false
