# ---------------------------------------------------------------------------
# Copy to .env and fill in. Every var below is explained in the README.
# ---------------------------------------------------------------------------

# Database.
#   Local dev (SQLite):  file:./dev.db
#   Vercel (Postgres):   postgresql://USER:PASS@HOST/DB?sslmode=require
# NOTE: switching to Postgres ALSO requires a one-line edit to
# prisma/schema.prisma (provider = "postgresql"). See README > Deploying to Vercel.
DATABASE_URL="file:./dev.db"

# Admin login. There is no user table -- these two values ARE the admin account.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"
# HS256 signing key for the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Email (Resend). Leave RESEND_API_KEY blank to run in local log-only mode:
# emails are printed to the server console and still recorded in EmailLog.
RESEND_API_KEY=""
EMAIL_FROM="Harbourside Sailing <bookings@yourdomain.com>"
# Safety net for demos: every outbound email is redirected to this address
# regardless of the customer's real address. Leave blank to send for real.
DEMO_EMAIL_REDIRECT=""
# Where the marketing-page contact form is delivered.
CONTACT_RECIPIENT_EMAIL="you@yourdomain.com"

# Stripe. Not required to run the app -- src/lib/payments.ts ships stubbed.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Absolute origin, used to build links inside emails.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Shared secret for GET /api/cron/reminders (Authorization: Bearer $CRON_SECRET).
CRON_SECRET=""
