// Marine Booking — demo schema.
//
// PORTABILITY RULES (SQLite local <-> Postgres on Vercel). Do not break these:
//   * No `enum` blocks     -> String columns + TS unions in src/lib/enums.ts
//   * No `@db.*` native types
//   * No `Decimal`         -> Int pence everywhere
//   * No `Json`
//   * No `migrations/`     -> `prisma db push` on BOTH environments
//
// The provider below is NOT env-swappable (Prisma 6 disallows env() here).
// Deploying to Postgres = set DATABASE_URL *and* change this one line.
// See README > Deploying to Vercel.
//
// CALENDAR DATES ARE STRINGS. A field that means "a day" and not "an instant"
// is a String holding "yyyy-MM-dd" (the LondonDate type in src/lib/time.ts).
// Storing a bare day as a DateTime is how you get a job planned for the 16th
// showing as the 15th on a laptop in BST. Instants (Visit.startsAt, every
// *At audit column) stay DateTime and stay UTC.
//
// DOMAIN NOTE: this models a marine TRADESPERSON -- a one-to-five person
// shipwright, rigger, marine engineer or electrician -- not a boatyard.
// See ANALYSIS-TRADES.md. The model names are deliberately domain-neutral and
// are NOT renamed, because renaming buys nothing but a very large diff:
//
//   Operator      = the trade business        (§6 "Business")
//   Vessel        = the boat                  (§6 "Boat")
//   Booking       = one job on one boat       (§6 "Job")
//   QuoteLineItem = one line of an estimate   (§6 "EstimateLine")
//
// PARKED (marina-era, behind FEATURE_YARD in src/lib/features.ts):
// SessionType, Session, SessionCancellation. Out of nav and out of the seed,
// code intact. Not dropped -- see ANALYSIS-TRADES.md §5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// The trade business. One row. Was the yard/operator; now the shipwright or
/// rigger who owns this install.
model Operator {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  timezone     String   @default("Europe/London")
  currency     String   @default("GBP")
  contactEmail String
  phone        String?
  createdAt    DateTime @default(now())

  /// Comma-separated trade slugs, e.g. "rigging,engineering". A String and not
  /// a join table: it drives copy and reminder defaults, nothing queries it.
  tradeTypes String  @default("")
  ownerName  String?

  /// Many sole traders are under the registration threshold. When false the
  /// app shows plain totals and the word VAT appears NOWHERE -- not a 0% line,
  /// not "inc. VAT". See ANALYSIS-TRADES.md §3.7.
  vatRegistered Boolean @default(false)
  vatNumber     String?

  defaultLabourRatePence Int @default(5500)

  /// Invoice numbering. nextInvoiceNumber is bumped inside the same
  /// transaction that creates the invoice, and a number is NEVER reused --
  /// voiding an invoice burns its number on purpose.
  invoicePrefix     String @default("INV-")
  nextInvoiceNumber Int    @default(1)

  paymentTermsDays Int @default(14)

  /// Free text printed on invoices ("Sort 00-00-00, Acct 12345678").
  /// NEVER store card data here or anywhere else in this schema.
  bankDetailsText String?

  sessionTypes SessionType[]
  sessions     Session[]
  customers    Customer[]
  vessels      Vessel[]
  bookings     Booking[]
  places       Place[]
  invoices     Invoice[]
}

/// Where boats live and where work happens. A boat MOVES between these --
/// hard standing in winter, a pontoon in summer, a swinging mooring -- which
/// is the thing that makes this different from a plumber's address book.
model Place {
  id         String  @id @default(cuid())
  operatorId String
  name       String
  /// What fits on a board card: "EYH hard", "Bosham mooring".
  shortName  String
  /// yard | marina | mooring | drying_mooring | trailer | other
  kind       String  @default("yard")
  /// "keys from the office", "hot works permit needed"
  notes      String?
  sortOrder  Int     @default(0)

  operator Operator  @relation(fields: [operatorId], references: [id])
  vessels  Vessel[]
  bookings Booking[]
  visits   Visit[]

  @@index([operatorId])
}

model Customer {
  id         String   @id @default(cuid())
  operatorId String
  name       String
  /// Always stored lowercased. Never query with mode:'insensitive' (Postgres-only).
  email      String
  phone      String?
  notes      String?
  createdAt  DateTime @default(now())

  operator Operator  @relation(fields: [operatorId], references: [id])
  vessels  Vessel[]
  bookings Booking[]

  @@unique([operatorId, email])
}

/// The boat. The trade talks about the boat first and the owner second, and
/// the same owner routinely has more than one.
///
/// customerId is NULLABLE: a jot can name a boat before anyone knows whose it
/// is. See Booking for the same reasoning.
model Vessel {
  id             String   @id @default(cuid())
  operatorId     String
  customerId     String?
  name           String
  /// "Westerly", "Beneteau"
  make           String?
  /// "Konsort", "Oceanis 350"
  model          String?
  year           Int?
  /// Length overall. Float metres, kept from the yard era; §6 asks for loaCm
  /// but re-basing the unit changes every display for no behaviour.
  lengthMetres   Float?
  /// Fin, bilge, long, lifting -- matters before anything is lifted.
  keelType       String?
  /// Where the boat is NOW. Moves are recorded as VesselMove rows.
  currentPlaceId String?
  notes          String?
  createdAt      DateTime @default(now())

  operator     Operator     @relation(fields: [operatorId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  currentPlace Place?       @relation(fields: [currentPlaceId], references: [id])
  bookings     Booking[]
  equipment    Equipment[]
  reminders    Reminder[]
  moves        VesselMove[]

  @@index([customerId])
  @@index([operatorId])
}

/// Where a boat has been. The boat file shows this as its history; nothing
/// else reads it. Append-only.
model VesselMove {
  id       String  @id @default(cuid())
  vesselId String
  /// LondonDate "yyyy-MM-dd"
  movedOn  String
  fromName String?
  toName   String
  note     String?

  vessel Vessel @relation(fields: [vesselId], references: [id], onDelete: Cascade)

  @@index([vesselId, movedOn])
}

/// Per-boat kit with an age or a service interval. THIS is what turns into
/// repeat work: standing rigging at 11 years is a rigging quote waiting to be
/// asked for, and the trade holding the record gets the job.
model Equipment {
  id       String  @id @default(cuid())
  vesselId String
  /// engine | outboard | standing_rigging | running_rigging | furler | sail
  /// | seacock | gas | electrics | other
  kind     String
  make     String?
  model    String?
  serial   String?

  /// LondonDate "yyyy-MM-dd". For standing rigging this is the age insurers
  /// and surveyors ask about.
  installedOn           String?
  hours                 Int?
  /// LondonDate "yyyy-MM-dd" -- when `hours` was last read off the clock.
  hoursRecordedOn       String?
  serviceIntervalMonths Int?
  serviceIntervalHours  Int?
  /// LondonDate "yyyy-MM-dd"
  lastServicedOn        String?
  notes                 String?
  createdAt             DateTime @default(now())

  vessel    Vessel     @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  reminders Reminder[]

  @@index([vesselId, kind])
}

/// ONE JOB. The card on the board.
///
/// vesselId and customerId are NULLABLE and that is the single most
/// load-bearing fact in this schema. ANALYSIS-TRADES.md §3.3: a job can exist
/// as one line of free text with no boat, no owner and no place, because
/// capture has to be quicker than writing it on the back of your hand.
/// Every "why is this nullable?" tidy-up breaks the whole premise of the
/// product. Same rule as quotedPence: a job exists before it has a price, and
/// now, before it has a boat.
///
/// `column` is the board column and is the job's real state. The legacy
/// `status` field below still drives the parked yard flow and the payment
/// seam; nothing on the board reads it.
model Booking {
  id         String  @id @default(cuid())
  /// Human-readable, e.g. HS-7QK2ND. Used in emails and as the public URL key.
  reference  String  @unique
  operatorId String
  /// NULL until the yard schedules it. PARKED with the rest of the diary.
  sessionId  String?
  customerId String?
  vesselId   String?

  /// What the owner said they wanted, in their words -- or, for a card created
  /// by Jot, the raw captured text, kept verbatim forever after it is sorted.
  requestNotes String?

  // ---- board state (ANALYSIS-TRADES.md §4) ----

  /// jotted | enquiry | estimate_sent | booked | waiting | on_it
  /// | done_to_invoice | invoiced | paid
  /// `paid` drops off the board into the boat's history.
  column String @default("jotted")

  /// Required whenever column = 'waiting'. Enforced in the action, not here:
  /// a CHECK constraint is not portable, and the rule is "you cannot SAVE a
  /// waiting card without a reason", which is a write-path rule.
  /// yard_lift | crane | parts | owner_decision | weather | tide | access | other
  waitingReason String?
  /// LondonDate "yyyy-MM-dd". When this passes, the card flashes so nothing
  /// rots in the Waiting column.
  waitingUntil  String?

  /// LondonDate "yyyy-MM-dd". The intended day, if there is one. Not a booking
  /// -- a Visit is the scheduled thing.
  plannedOn String?
  /// Where the WORK happens, which may not be where the boat usually lives.
  placeId   String?

  /// Ordering within a column. Sparse (100, 200, 300) so a card can be dropped
  /// between two others without renumbering the column.
  position Int @default(0)

  /// Set every time the card lands in a column, so the board can say "in
  /// Waiting for 9 days" and the timeline has something to draw.
  columnChangedAt DateTime @default(now())

  // ---- price ----

  /// The ACCEPTED total. NULL until an estimate is accepted -- a job exists
  /// before it has a price. Snapshotted, never re-totalled under the owner.
  quotedPence Int?
  quotedAt    DateTime?
  quoteNotes  String?
  acceptedAt  DateTime?

  /// PARKED. The yard took a deposit at acceptance; a tradesperson invoices on
  /// completion. Kept so the parked flow still type-checks.
  depositPence Int?

  // ---- parked yard lifecycle ----

  /// enquiry | quoted | declined | pending_payment | paid | expired
  /// | cancelled | awaiting_rebook | completed | no_show
  /// PARKED: the board reads `column`. This still drives the yard screens and
  /// the payment seam.
  status    String    @default("enquiry")
  expiresAt DateTime?

  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?   @unique
  paidAt                  DateTime?

  completedAt        DateTime?
  attendanceMarkedAt DateTime?
  cancelledAt        DateTime?

  rebookToken           String?   @unique
  rebookedFromSessionId String?
  rebookedAt            DateTime?

  /// PARKED: superseded by Estimate.token. Kept until F3 moves the flow over.
  quoteToken String? @unique

  reminderSentAt DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operator   Operator        @relation(fields: [operatorId], references: [id])
  session    Session?        @relation(fields: [sessionId], references: [id])
  customer   Customer?       @relation(fields: [customerId], references: [id])
  vessel     Vessel?         @relation(fields: [vesselId], references: [id])
  place      Place?          @relation(fields: [placeId], references: [id])
  emailLogs  EmailLog[]
  lineItems  QuoteLineItem[]
  estimates  Estimate[]
  variations Variation[]
  partOrders PartOrder[]
  visits     Visit[]
  invoices   Invoice[]

  @@index([operatorId, column, position])
  @@index([sessionId, status])
  @@index([customerId])
  @@index([vesselId])
  @@index([status, createdAt])
}

/// §6 "EstimateLine". One line of work on a job: labour, parts, subcontract.
///
/// The lines live on the JOB, not on the Estimate. That is deliberate: they
/// are the working list the trade ticks off as work is done (`done`), and an
/// Estimate is a document *sent* at a point in time that snapshots their
/// total. An Invoice snapshots them again into InvoiceLine.
model QuoteLineItem {
  id          String @id @default(cuid())
  bookingId   String
  /// labour | parts | subcontract | other
  kind        String @default("labour")
  description String

  /// Quantity. Float because labour is quoted in hours and 2.5h is normal.
  /// Money stays Int pence; this is not money.
  qty            Float @default(1)
  unitPricePence Int   @default(0)

  /// amountPence = round(qty * unitPricePence), computed on write in ONE
  /// place so there is no second source of truth for a line total. Stored
  /// rather than derived so a sent estimate cannot be re-totalled by a later
  /// rounding change.
  amountPence Int

  /// Basis points: 2000 = 20%. IGNORED ENTIRELY when the business is not
  /// VAT-registered -- not zeroed, not shown.
  vatRateBps Int @default(0)

  /// Ticked when the work on this line is actually done. Drives what lands on
  /// the invoice.
  done Boolean @default(false)

  sortOrder Int @default(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

/// A priced document sent to the owner. Non-binding: the word is ESTIMATE, not
/// quote -- time and materials, extra work expected (§3.6).
///
/// Re-estimating supersedes rather than edits, so what the owner agreed to is
/// still readable after the price changes.
model Estimate {
  id        String @id @default(cuid())
  bookingId String

  /// draft | sent | accepted | declined | superseded
  status String @default("draft")

  /// Snapshotted at send. Never recomputed from the lines afterwards.
  totalPence Int
  vatPence   Int     @default(0)
  notes      String?

  sentAt       DateTime?
  decidedAt    DateTime?
  /// link | phone | in_person | text
  /// "Agreed by phone" is ALWAYS available (§3.5). The app records what
  /// happened; it never forces the owner online.
  decidedVia   String?
  decisionNote String?

  /// Single-use, cleared the moment it is spent.
  token String? @unique

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
}

/// Extra work found once the job is open -- the seized seacock. Raised in
/// three fields from a card; approved by link or recorded as agreed by phone.
/// An unanswered variation puts a dot on the board card.
model Variation {
  id            String  @id @default(cuid())
  bookingId     String
  description   String
  /// Why it is needed. This is the bit that stops the argument in March.
  reason        String?
  estimatePence Int

  /// awaiting_owner | approved | declined | withdrawn
  status String @default("awaiting_owner")

  /// link | phone | in_person | text
  decidedVia   String?
  decidedAt    DateTime?
  decisionNote String?

  token          String?   @unique
  /// Exactly one chase, 24h after raising. Not a drip campaign.
  reminderSentAt DateTime?

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
}

/// Parts on order. When the last outstanding part arrives the app offers to
/// move the card out of Waiting -- it does not move it on its own.
model PartOrder {
  id        String  @id @default(cuid())
  bookingId String
  item      String
  supplier  String?
  /// LondonDate "yyyy-MM-dd"
  orderedOn String?
  etaOn     String?
  arrivedOn String?
  costPence Int?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

/// A planned attendance: this boat, this place, this day. Postponing one emails
/// the owner (the repointed cancel/rebook machinery).
model Visit {
  id             String    @id @default(cuid())
  bookingId      String
  placeId        String?
  startsAt       DateTime
  endsAt         DateTime?
  /// planned | done | postponed
  status         String    @default("planned")
  /// weather | tide | parts | access | other -- free text note alongside.
  postponeReason String?
  postponeNote   String?
  createdAt      DateTime  @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  place   Place?  @relation(fields: [placeId], references: [id])

  @@index([bookingId, startsAt])
}

/// A numbered invoice. Numbers are sequential per business and NEVER reused,
/// even after a void -- that is an accounting rule, not a preference.
model Invoice {
  id         String @id @default(cuid())
  operatorId String
  bookingId  String

  /// Prefix + sequence, e.g. "HMS-0007". Unique across the business.
  number String @unique

  /// LondonDate "yyyy-MM-dd"
  issuedOn String
  dueOn    String

  totalPence Int
  vatPence   Int @default(0)

  /// draft | sent | paid | void
  status String @default("draft")

  /// LondonDate "yyyy-MM-dd"
  paidOn  String?
  /// link | bank | cash | card_machine
  paidVia String?

  /// One chase at the due date, one at +7 days. Two columns, not a table: the
  /// app sends exactly two and then stops nagging.
  dueReminderSentAt     DateTime?
  overdueReminderSentAt DateTime?

  stripeCheckoutSessionId String? @unique
  token                   String? @unique

  notes     String?
  createdAt DateTime @default(now())

  operator Operator      @relation(fields: [operatorId], references: [id])
  booking  Booking       @relation(fields: [bookingId], references: [id])
  lines    InvoiceLine[]

  @@index([bookingId])
  @@index([operatorId, status])
}

/// Snapshotted at issue from the job's done QuoteLineItems plus its approved
/// Variations. A copy, not a relation: editing a job after invoicing must not
/// change what was billed.
model InvoiceLine {
  id             String @id @default(cuid())
  invoiceId      String
  description    String
  qty            Float  @default(1)
  unitPricePence Int    @default(0)
  amountPence    Int
  vatRateBps     Int    @default(0)
  sortOrder      Int    @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Work this boat is due. Computed nightly from Equipment ages and intervals,
/// plus the seasonal sweeps. Sending a batch of these is the sales pitch: it
/// is work the trade did not have to chase.
model Reminder {
  id          String  @id @default(cuid())
  vesselId    String
  equipmentId String?

  /// service_due | rig_age | antifoul | winterise | commission | custom
  kind   String
  /// LondonDate "yyyy-MM-dd"
  dueOn  String
  /// upcoming | sent | booked | dismissed
  status String @default("upcoming")

  /// Shown to the owner verbatim in the email.
  message String?

  sentAt    DateTime?
  /// Single-use "Yes, book me in" link -- creates an Enquiry card on the board.
  token     String?   @unique
  /// Set when the owner clicked through and a card was raised.
  bookingId String?

  createdAt DateTime @default(now())

  vessel    Vessel     @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([vesselId, status])
  @@index([status, dueOn])
}

// ---------------------------------------------------------------------------
// PARKED — marina/yard era. Behind FEATURE_YARD. Out of nav, out of the seed.
// Not dropped: ANALYSIS-TRADES.md §5 says park, and asks before any table goes.
// ---------------------------------------------------------------------------

/// PARKED. A service the yard offered: liftout, survey, rig inspection.
model SessionType {
  id              String  @id @default(cuid())
  operatorId      String
  name            String
  slug            String
  description     String?
  durationMinutes Int
  defaultCapacity Int     @default(1)
  depositPercent  Int     @default(50)
  tideDependent   Boolean @default(false)
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  operator Operator  @relation(fields: [operatorId], references: [id])
  sessions Session[]

  @@unique([operatorId, slug])
}

/// PARKED. A bookable slot in the yard diary.
model Session {
  id            String   @id @default(cuid())
  operatorId    String
  sessionTypeId String
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int
  /// scheduled | cancelled
  status        String   @default("scheduled")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  operator     Operator             @relation(fields: [operatorId], references: [id])
  sessionType  SessionType          @relation(fields: [sessionTypeId], references: [id])
  bookings     Booking[]
  cancellation SessionCancellation?

  @@index([operatorId, startsAt])
  @@index([sessionTypeId, startsAt])
}

/// PARKED. Repointed in F4 to "visit postponed" -- see Visit.
model SessionCancellation {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  /// weather | tide | mechanical | other
  reason      String
  note        String?
  cancelledAt DateTime @default(now())
  cancelledBy String   @default("admin")

  session Session @relation(fields: [sessionId], references: [id])
}

// ---------------------------------------------------------------------------

/// The evidence trail behind "8 owners notified".
/// Counted, never stored as a counter -- nothing to drift out of step with
/// what was actually sent. This is why the local-mode email path still writes
/// rows with no Resend key: otherwise the headline number reads 0 in a demo.
model EmailLog {
  id String @id @default(cuid())

  /// enquiry_received | estimate | variation | variation_reminder
  /// | job_update | visit_postponed | service_reminder | invoice
  /// | invoice_reminder | contact_form
  /// (plus the parked yard types: quote, booking_confirmation, cancellation,
  /// rebook_confirmation, reminder)
  type        String
  /// The owner's real address (what we intended).
  toEmail     String
  /// Where it actually went (DEMO_EMAIL_REDIRECT, if set).
  deliveredTo String
  subject     String
  /// sent | failed
  status      String
  /// Resend message id, or 'local-dev' when running without RESEND_API_KEY.
  providerId  String?
  error       String?

  bookingId  String?
  sessionId  String?
  customerId String?
  vesselId   String?

  createdAt DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([sessionId, type])
  @@index([bookingId])
  @@index([type, createdAt])
}

/// Stripe webhook idempotency. The handler creates this row FIRST, inside the
/// transaction; a P2002 unique violation means "already processed, return 200".
/// (Model only -- the handler belongs to the payments specialist.)
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// Persisted so a Resend outage cannot silently swallow a lead mid-demo.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  business  String?
  message   String
  createdAt DateTime @default(now())
}
