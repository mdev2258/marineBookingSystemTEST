// Marine Booking — demo schema.
//
// PORTABILITY RULES (SQLite local <-> Postgres on Vercel). Do not break these:
//   * No `enum` blocks     -> String columns + TS unions in src/lib/enums.ts
//   * No `@db.*` native types
//   * No `Decimal`         -> Int pence everywhere
//   * No `Json`
//   * No `migrations/`     -> `prisma db push` on BOTH environments
//
// The provider below is NOT env-swappable (Prisma 6 disallows env() here).
// Deploying to Postgres = set DATABASE_URL *and* change this one line.
// See README > Deploying to Vercel.
//
// DOMAIN NOTE: this models a marine SERVICES yard -- liftouts, surveys,
// inspections, rigging, shipwright work. The model names (Session, Booking,
// SessionType) are deliberately domain-neutral and are NOT renamed to
// Slot/Job/Service: they were chosen generic so the same code serves a
// different trade, and renaming them buys nothing but a very large diff.
// Read them as: SessionType = a service offered, Session = a bookable slot in
// the yard diary, Booking = one job on one vessel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// The business. Deliberately generic: one row is the fictional operator.
model Operator {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  timezone     String   @default("Europe/London")
  currency     String   @default("GBP")
  contactEmail String
  phone        String?
  createdAt    DateTime @default(now())

  sessionTypes SessionType[]
  sessions     Session[]
  customers    Customer[]
  vessels      Vessel[]
  bookings     Booking[]
}

/// A service the yard offers: liftout, pre-purchase survey, rig inspection.
/// Swap the rows and this is a different trade; no code changes.
///
/// There is no default price. Every job here is quoted on the boat, so price
/// lives on the Booking once the yard has seen what it is dealing with.
model SessionType {
  id              String  @id @default(cuid())
  operatorId      String
  name            String
  slug            String
  description     String?
  durationMinutes Int
  /// How many vessels the yard can take in one slot. Usually 1 -- a crane does
  /// one boat at a time -- but a surveyor's day might hold several.
  defaultCapacity Int     @default(1)
  /// Percentage of the agreed quote taken to confirm the booking.
  depositPercent  Int     @default(50)
  /// Some work is scheduled against a tide window rather than a clock.
  tideDependent   Boolean @default(false)
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  operator Operator  @relation(fields: [operatorId], references: [id])
  sessions Session[]

  @@unique([operatorId, slug])
}

/// A bookable slot in the yard diary. capacity is SNAPSHOTTED from the
/// service's default at creation, then independently editable.
model Session {
  id            String   @id @default(cuid())
  operatorId    String
  sessionTypeId String
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int
  /// scheduled | cancelled
  status        String   @default("scheduled")
  /// e.g. "HW Lymington 11:20" -- shown to the customer on a tidal slot.
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  operator     Operator             @relation(fields: [operatorId], references: [id])
  sessionType  SessionType          @relation(fields: [sessionTypeId], references: [id])
  bookings     Booking[]
  cancellation SessionCancellation?

  @@index([operatorId, startsAt])
  @@index([sessionTypeId, startsAt])
}

model Customer {
  id         String   @id @default(cuid())
  operatorId String
  name       String
  /// Always stored lowercased. Never query with mode:'insensitive' (Postgres-only).
  email      String
  phone      String?
  createdAt  DateTime @default(now())

  operator Operator  @relation(fields: [operatorId], references: [id])
  vessels  Vessel[]
  bookings Booking[]

  @@unique([operatorId, email])
}

/// The boat. A yard talks about the vessel first and the owner second, and the
/// same owner routinely has more than one.
model Vessel {
  id           String   @id @default(cuid())
  operatorId   String
  customerId   String
  name         String
  /// Length overall. Drives the crane strop setup and most of the quote.
  lengthMetres Float?
  /// "Westerly Konsort", "Fairline Targa 34"
  make         String?
  /// Fin, bilge, long -- the yard needs this before it lifts anything.
  keelType     String?
  /// "Pontoon C, berth 14" or "Ashore, yard row 3"
  berth        String?
  notes        String?
  createdAt    DateTime @default(now())

  operator Operator  @relation(fields: [operatorId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  bookings Booking[]

  @@index([customerId])
}

/// One job, on one vessel. The centre of the model.
///
/// A job arrives one of two ways and the difference is whether sessionId is
/// set at creation:
///   * the customer books a published slot  -> sessionId set, status 'enquiry'
///   * the customer requests work           -> sessionId null, status 'enquiry'
/// Either way the yard quotes it, the customer accepts, and only then is there
/// a deposit to pay.
model Booking {
  id         String @id @default(cuid())
  /// Human-readable, e.g. HS-7QK2ND. Used in emails and as the public URL key.
  reference  String @unique
  operatorId String
  /// NULL until the yard schedules it. An unscheduled job is a real job.
  sessionId  String?
  customerId String
  vesselId   String

  /// What the customer said they wanted, in their words.
  requestNotes String?

  /// The quote TOTAL. NULL until the yard has priced the job -- this is why
  /// depositPence is nullable too, and why nothing may assume a price exists.
  /// When lineItems exist this is their sum, computed once at quote time and
  /// stored, so a quote already sent can never be re-totalled underneath the
  /// customer by a later edit.
  quotedPence Int?
  quotedAt    DateTime?
  /// Free text shown with the quote: what is and is not included.
  quoteNotes  String?
  acceptedAt  DateTime?

  /// Math.round(depositPercent/100 * quotedPence), computed ONCE when the
  /// customer accepts the quote and never recomputed. It survives a later
  /// re-quote and it transfers unchanged when a job is rebooked onto a new slot.
  depositPence Int?

  /// enquiry | quoted | declined | pending_payment | paid | expired
  /// | cancelled | awaiting_rebook | completed | no_show
  status    String    @default("enquiry")
  /// When a pending_payment hold stops consuming a slot. Mirrors Stripe
  /// Checkout expires_at (30 min, Stripe's minimum).
  expiresAt DateTime?

  stripeCheckoutSessionId String?   @unique
  stripePaymentIntentId   String?   @unique
  paidAt                  DateTime?

  /// Work done, or the boat was not there / not ready.
  completedAt        DateTime?
  attendanceMarkedAt DateTime?
  cancelledAt        DateTime?

  /// Single-use token emailed to the customer when their slot is cancelled.
  rebookToken           String?   @unique
  /// Set when this row was MOVED off a cancelled slot onto a new one.
  rebookedFromSessionId String?
  rebookedAt            DateTime?

  /// Single-use token emailed with a quote, so the customer can accept it
  /// without an account. Cleared the moment it is spent.
  quoteToken String? @unique

  /// Lives here, not on Session: reminders are per-job.
  reminderSentAt DateTime?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operator  Operator        @relation(fields: [operatorId], references: [id])
  session   Session?        @relation(fields: [sessionId], references: [id])
  customer  Customer        @relation(fields: [customerId], references: [id])
  vessel    Vessel          @relation(fields: [vesselId], references: [id])
  emailLogs EmailLog[]
  lineItems QuoteLineItem[]

  @@index([sessionId, status])
  @@index([customerId])
  @@index([status, createdAt])
}

/// One line on a quote: "Wire, terminals & turnbuckles — 1 set — £1,420".
///
/// Quantity is free text rather than a number. A yard quotes in its own units
/// -- "1 set", "32h", "2 lifts", or nothing at all for consumables -- and
/// forcing that into a decimal with a separate unit column buys nothing when
/// the line total is typed anyway.
model QuoteLineItem {
  id          String  @id @default(cuid())
  bookingId   String
  description String
  quantity    String?
  amountPence Int
  sortOrder   Int     @default(0)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model SessionCancellation {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  /// weather | tide | mechanical | other
  reason      String
  /// Free text, shown verbatim in the cancellation email.
  note        String?
  cancelledAt DateTime @default(now())
  cancelledBy String   @default("admin")

  session Session @relation(fields: [sessionId], references: [id])
}

/// The evidence trail behind "3 customers notified".
/// Notified count = count(EmailLog where sessionId=X, type='cancellation', status='sent').
/// One query, one source of truth -- no denormalised counter to drift.
model EmailLog {
  id String @id @default(cuid())

  /// enquiry_received | quote | booking_confirmation | cancellation
  /// | rebook_confirmation | reminder | contact_form
  type String
  /// The customer's real address (what we intended).
  toEmail     String
  /// Where it actually went (DEMO_EMAIL_REDIRECT, if set).
  deliveredTo String
  subject     String
  /// sent | failed
  status      String
  /// Resend message id, or 'local-dev' when running without RESEND_API_KEY.
  providerId  String?
  error       String?

  bookingId  String?
  sessionId  String?
  customerId String?

  createdAt DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id])

  @@index([sessionId, type])
  @@index([bookingId])
}

/// Stripe webhook idempotency. The handler creates this row FIRST, inside the
/// transaction; a P2002 unique violation means "already processed, return 200".
/// (Model only -- the handler belongs to the payments specialist.)
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

/// Persisted so a Resend outage cannot silently swallow a lead mid-demo.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  business  String?
  message   String
  createdAt DateTime @default(now())
}
